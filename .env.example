# Gemini API anahtarı iki yoldan biriyle verilir:
#   1) Bu dosyada (aşağıdaki satırı açıp doldurun) veya
#   2) Uygulamayı açıp "Gemini API anahtarı" kartından girin.
# Arayüzden girilen anahtar kalıcıdır (yeniden başlatmada hatırlanır) ve
# bu dosyadaki değere göre önceliklidir. Anahtarı bu dosyaya yazmak zorunlu değildir.
# GEMINI_API_KEY=AIzaSy...

# Arayüzden girilen anahtarın saklanacağı dosya.
# Varsayılan: proje kökündeki data/api-key.json (web kökü dışında).
# Docker'da /app/data/api-key.json olarak ayarlanır; data volume'u kullanın.
# API_KEY_STORE_PATH=./data/api-key.json

# Backend'in dinleyeceği port
PORT=3000

# Frontend'in sunulduğu origin(ler) - CORS için virgülle ayırın
# Backend aynı origin'den statik frontend servis ediyorsa bu genelde gerekmez.
ALLOWED_ORIGINS=http://localhost:3000

# Ters proxy (nginx/cloudflare) arkasındaysanız: 1 veya "loopback".
# Üretimde tanımlı değilse tüm istemciler aynı IP görünür ve başlangıçta uyarı yazılır.
# TRUST_PROXY=1

# IP başına dakikada izin verilen analiz isteği sayısı
RATE_LIMIT_PER_MINUTE=5

# Süreç genelinde dakikada izin verilen toplam analiz isteği (maliyet koruması)
GLOBAL_ANALYSIS_LIMIT_PER_MINUTE=30

# Takip soruları için ayrı, dar sınır (her soru ayrı bir Gemini çağrısıdır)
FOLLOWUP_RATE_LIMIT_PER_MINUTE=6

# Diğer API uçları (SSE, polling) için dakikalık istek sınırı
API_RATE_LIMIT_PER_MINUTE=120

# İlan linki tarama (dış siteye istek) için ayrı dakikalık sınır
LISTING_RATE_LIMIT_PER_MINUTE=10

# API anahtarı kaydetme/test/silme uçları için dakikalık sınır
SETTINGS_RATE_LIMIT_PER_MINUTE=10

# Varsayılan Gemini modeli ve izinli model listesi (virgülle)
DEFAULT_GEMINI_MODEL=gemini-3.5-flash
GEMINI_ALLOWED_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-pro-preview

# Google Search (grounding) bu API anahtarında kapalı/limitsizse false yapın.
# true iken arama kotası yoksa uygulama 429 alır ve analizi aramasız sürdürür.
GEMINI_SEARCH_ENABLED=true

# Eşzamanlı analiz sayısı (Gemini kotasını korumak için)
MAX_CONCURRENT_ANALYSES=3

# Kuyrukta bekleyebilecek en fazla iş (fazlası 429 QUEUE_FULL alır)
MAX_QUEUED_JOBS=20
MAX_JOBS=200
JOB_TTL_MS=600000
JOB_TIMEOUT_MS=300000

# Bir analiz için sorulabilecek en fazla takip sorusu (rapor altındaki "Rapora soru sor")
MAX_FOLLOWUPS_PER_JOB=10

# Tek takip sorusunun toplam üst süresi
FOLLOWUP_TIMEOUT_MS=90000

# Takip turunda yeniden gönderilecek en fazla fotoğraf ve foto başına base64 karakter sınırı
FOLLOWUP_IMAGE_LIMIT=2
FOLLOWUP_IMAGE_MAX_BYTES=700000

# Tamamlanmış işlerde takip için bellekte tutulan toplam fotoğraf bütçesi (MB)
RETAINED_IMAGE_BUDGET_MB=64

# İstek gövdesi limiti ve sunucu zaman aşımı
BODY_LIMIT=32mb
REQUEST_TIMEOUT_MS=180000

# Gemini tek deneme zaman aşımı ve retry sayısı
GEMINI_TIMEOUT_MS=120000
GEMINI_MAX_RETRIES=2

# Log seviyesi: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info
